# Chave da API OpenCode Go (obrigatória)
OPENCODE_API_KEY=
# URL base da API OpenCode Go
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Identificador do modelo principal de atendimento
MODEL_ID=deepseek-v4.1-flash
# Identificador do modelo avaliador (para testes e validações)
JUDGE_MODEL_ID=deepseek-v4.1-flash
# Data de referência para cálculos (vazio = data do sistema)
REFERENCE_DATE=
# Número máximo de iterações de ferramentas por chamada
MAX_TOOL_ITERATIONS=6
# Timeout em segundos para chamadas ao LLM
LLM_TIMEOUT_SECONDS=30
# Número máximo de tentativas em caso de falha
LLM_MAX_RETRIES=3
# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Temperatura do modelo (0 a 2; menor = respostas mais estáveis)
LLM_TEMPERATURE=0.2
# Versão do system prompt (arquivo em src/emporio/prompts/, ex.: v1, v2)
PROMPT_VERSION=v3
# Teto de tokens por resposta (evita reservar o máximo do modelo e limita custo)
LLM_MAX_TOKENS=1024
